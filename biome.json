{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useNodejsImportProtocol": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": ["extensions/**/*.ts", "!**/node_modules/**/*"]
	}
}
