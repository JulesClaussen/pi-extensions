{
  "name": "@jules/pi-extensions",
  "version": "0.1.0",
  "description": "Personal pi extensions: command guard, working modes, worker subagents.",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "coding-agent"],
  "license": "MIT",
  "author": "jules",
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "extensions": ["extensions/*/index.ts"]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "latest",
    "tsx": "^4.19.2",
    "typebox": "^1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --import tsx --test 'extensions/**/*.test.ts'",
    "typecheck": "tsgo -p tsconfig.json",
    "lint": "biome check .",
    "fmt": "biome format --write ."
  }
}
